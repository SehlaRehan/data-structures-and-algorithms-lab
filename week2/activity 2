#include <iostream>
using namespace std;

struct Nodetype
{
    int data;
    Nodetype *next;
};

Nodetype *first = NULL;
Nodetype *last = NULL;

void insert_end()
{
    Nodetype *p;

    p = new Nodetype;

    cout << "Enter the data in node: ";
    cin >> p->data;

    p->next = NULL;

    if (first == NULL)
    {
        first = last = p;
    }
    else
    {
        last->next = p;
        last = p;
    }
}

void display()
{
    Nodetype *p = first;

    while (p != NULL)
    {
        cout << p->data << " ";
        p = p->next;
    }
}

int main()
{
    insert_end();
    insert_end();
    insert_end();

    cout << "Linked List: ";
    display();

    return 0;
}
