
// ===== LAB TASK 3: Find multiple occurrences =====
void findMultipleOccurrences(int key) {
    Node* p = first;
    int pos = 0;
    int count = 0;
    cout << "Occurrences of " << key << " at positions: ";
    while (p!= NULL) {
        if (p->data == key) {
            cout << pos << " ";
            count++;
        }
        p = p->next;
        pos++;
    }
    if (count == 0) cout << "Not Found";
    else cout << "\nTotal count: " << count;
    cout << endl;
}

