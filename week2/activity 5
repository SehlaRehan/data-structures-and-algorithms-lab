#include <iostream>
using namespace std;

struct Nodetype
{
    int data;
    Nodetype *next;
};

Nodetype *first = NULL;
Nodetype *last = NULL;

void insert_end(int value)
{
    Nodetype *p = new Nodetype;

    p->data = value;
    p->next = NULL;

    if (first == NULL)
    {
        first = last = p;
    }
    else
    {
        last->next = p;
        last = p;
    }
}

Nodetype* search(int key)
{
    Nodetype *p = first;

    while (p != NULL && p->data != key)
    {
        p = p->next;
    }

    return p;
}

void insert_after(int key)
{
    Nodetype *p = NULL;

    p = search(key);

    if (p == NULL)
    {
        cout << "Value not found.";
    }
    else
    {
        Nodetype *Newnode;

        Newnode = new Nodetype;

        cout << "Enter the data in new node: ";
        cin >> Newnode->data;

        if (p == last)
        {
            Newnode->next = NULL;
            last->next = Newnode;
            last = Newnode;
        }
        else
        {
            Newnode->next = p->next;
            p->next = Newnode;
        }

        cout << "New node linked successfully.";
    }
}

void display()
{
    Nodetype *p = first;

    while (p != NULL)
    {
        cout << p->data << " ";
        p = p->next;
    }
}

int main()
{
    insert_end(10);
    insert_end(20);
    insert_end(30);

    int key;

    cout << "Enter value after which you want to insert: ";
    cin >> key;

    insert_after(key);

    cout << "\nLinked List: ";
    display();

    return 0;
}
