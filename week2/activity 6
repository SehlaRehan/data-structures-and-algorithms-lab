#include <iostream>
using namespace std;

struct Nodetype
{
    int data;
    Nodetype *next;
};

Nodetype *first = NULL;
Nodetype *last = NULL;

void insert_end(int value)
{
    Nodetype *p = new Nodetype;

    p->data = value;
    p->next = NULL;

    if (first == NULL)
    {
        first = last = p;
    }
    else
    {
        last->next = p;
        last = p;
    }
}

void delete_first()
{
    Nodetype *p;

    if (first == NULL)
    {
        cout << "Linked List is empty";
    }
    else
    {
        p = first;

        first = first->next;

        if (first == NULL)
        {
            last = NULL;
        }

        delete p;

        cout << "First node deleted.";
    }
}

void display()
{
    Nodetype *p = first;

    while (p != NULL)
    {
        cout << p->data << " ";
        p = p->next;
    }
}

int main()
{
    insert_end(10);
    insert_end(20);
    insert_end(30);

    cout << "Before deletion: ";
    display();

    cout << endl;

    delete_first();

    cout << "\nAfter deletion: ";
    display();

    return 0;
}
