#include <iostream>
using namespace std;

struct Nodetype
{
    int data;
    Nodetype *next;
};

Nodetype *first = NULL;
Nodetype *last = NULL;

Nodetype* search(int key)
{
    Nodetype *p = NULL;

    p = first;

    while (p != NULL && p->data != key)
    {
        p = p->next;
    }

    return p;
}

void insert_end(int value)
{
    Nodetype *p = new Nodetype;

    p->data = value;
    p->next = NULL;

    if (first == NULL)
    {
        first = last = p;
    }
    else
    {
        last->next = p;
        last = p;
    }
}

int main()
{
    insert_end(10);
    insert_end(20);
    insert_end(30);

    int key;

    cout << "Enter value to search: ";
    cin >> key;

    Nodetype *result = search(key);

    if (result != NULL)
        cout << "Value found.";
    else
        cout << "Value not found.";

    return 0;
}
