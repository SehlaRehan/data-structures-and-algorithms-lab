#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

Node* first = NULL;
Node* last = NULL;

void insertAtEnd(int val) {
    Node* newNode = new Node();
    newNode->data = val;
    newNode->next = NULL;
    if (first == NULL) {
        first = last = newNode;
    } else {
        last->next = newNode;
        last = newNode;
    }
}

void display() {
    Node* p = first;
    cout << "List: ";
    while (p!= NULL) {
        cout << p->data << " -> ";
        p = p->next;
    }
    cout << "NULL" << endl;
}

// ===== LAB TASK 1: Display in Reverse =====

// 1a) Using Loop (Iterative) - using stack logic
void displayReverseLoop() {
    cout << "Reverse (Loop): ";
    // simple approach - reverse the links temporarily or use array
    int arr[100], n=0;
    Node* p = first;
    while(p!= NULL){
        arr[n++] = p->data;
        p = p->next;
    }
    for(int i=n-1; i>=0; i--){
        cout << arr[i] << " -> ";
    }
    cout << "NULL" << endl;
}

// 1b) Using Recursive approach
void displayReverseRecursive(Node* p) {
    if (p == NULL) return;
    displayReverseRecursive(p->next);
    cout << p->data << " -> ";
}

void displayReverseRecursiveWrapper(){
    cout << "Reverse (Recursive): ";
    displayReverseRecursive(first);
    cout << "NULL" << endl;
}

// ===== LAB TASK 2: Merge two lists into third =====
Node* mergeTwoLists(Node* list1, Node* list2) {
    Node* thirdFirst = NULL;
    Node* thirdLast = NULL;

    Node* p = list1;
    while (p!= NULL) {
        Node* newNode = new Node();
        newNode->data = p->data;
        newNode->next = NULL;
        if (thirdFirst == NULL) thirdFirst = thirdLast = newNode;
        else { thirdLast->next = newNode; thirdLast = newNode; }
        p = p->next;
    }

    p = list2;
    while (p!= NULL) {
        Node* newNode = new Node();
        newNode->data = p->data;
        newNode->next = NULL;
        if (thirdFirst == NULL) thirdFirst = thirdLast = newNode;
        else { thirdLast->next = newNode; thirdLast = newNode; }
        p = p->next;
    }
    return thirdFirst;
}

void displayList(Node* head){
    Node* p = head;
    while(p!=NULL){
        cout << p->data << " -> ";
        p = p->next;
    }
    cout << "NULL" << endl;
}

// ===== LAB TASK 3: Find multiple occurrences =====
void findMultipleOccurrences(int key) {
    Node* p = first;
    int pos = 0;
    int count = 0;
    cout << "Occurrences of " << key << " at positions: ";
    while (p!= NULL) {
        if (p->data == key) {
            cout << pos << " ";
            count++;
        }
        p = p->next;
        pos++;
    }
    if (count == 0) cout << "Not Found";
    else cout << "\nTotal count: " << count;
    cout << endl;
}

