    // list1: 1->2->3
    for(int v : {1,2,3}){
        Node* n = new Node{v, NULL};
        if(!list1) list1 = list1Last = n; else { list1Last->next=n; list1Last=n; }
    }
    // list2: 4->5->6
    for(int v : {4,5,6}){
        Node* n = new Node{v, NULL};
        if(!list2) list2 = list2Last = n; else { list2Last->next=n; list2Last=n; }
    }

    cout << "\nList1: "; displayList(list1);
    cout << "List2: "; displayList(list2);
