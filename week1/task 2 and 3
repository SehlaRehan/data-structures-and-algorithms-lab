#include <iostream>
using namespace std;

int main() {
    int start, stop;
    long long sum = 0;

    cout << "Enter starting value: ";
    cin >> start;
    cout << "Enter stopping value: ";
    cin >> stop;

    for (int X = start; X <= stop; X++) {
        sum = sum + (X * X); // ΣX²
    }

    cout << "Sum of squares from " << start << " to " << stop << " is: " << sum << endl;
    return 0;
}
